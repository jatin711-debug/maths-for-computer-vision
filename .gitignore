# Publish the course only; build caches and scratch files in this workspace stay local.
/*
!/.gitignore
!/.github/
!/README.md
!/LICENSE
!/LICENSE-CONTENT.md
!/Makefile
!/Open Course.cmd
!/Open-Course.ps1
!/course/
!/docs/
!/video-studio/

# The cited books are not redistributed (see course/resources/README.md).
/course/resources/*.pdf
/course/resources/copy-manifest.json

# Local caches
__pycache__/
*.pyc
.ipynb_checkpoints/

# Practical labs download their own datasets and weights; outputs stay local.
/course/practical/data/
/course/practical/runs/
/course/practical/.venv/
/course/practical/.cache/
